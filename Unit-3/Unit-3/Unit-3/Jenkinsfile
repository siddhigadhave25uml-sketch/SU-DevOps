pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Install dependencies') {
            steps { sh 'python -m pip install -r requirements.txt' }
        }
        stage('Validate syntax') {
            steps { sh 'python -m py_compile app.py database.py' }
        }
        stage('Run tests') {
            steps { sh 'pytest -q' }
        }
    }
}
